{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haecceity:schema:presentation:1",
  "title": "haecceity.presentation/1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "haecceity.presentation/1"
    },
    "length_unit": {
      "const": "millimetre"
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Graphic"
        }
      }
    },
    "unlinked": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Graphic"
      }
    },
    "semantic_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Sorted ids of every item in the companion PMI document; compare before using links."
    }
  },
  "required": [
    "schema",
    "length_unit",
    "items",
    "unlinked",
    "semantic_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "Graphic": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "generated",
            "file"
          ]
        },
        "name": {
          "type": "string"
        },
        "polylines": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "triangles": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "step_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "source",
        "name",
        "polylines",
        "triangles",
        "text",
        "step_ids",
        "unsupported"
      ],
      "additionalProperties": false
    }
  }
}
